{
     "compilerOptions": {
          "module": "commonjs",
          "target": "es2017",
          "lib": ["ES2022", "DOM"],
          "skipLibCheck": true,
          "allowJs": true,
          "outDir": "build",
          "rootDir": "src",
          "strict": true,
          "noImplicitAny": true,
          "esModuleInterop": true,
          "noUnusedLocals": true,
          "resolveJsonModule": true,
          "noUnusedParameters": true,      
          "emitDecoratorMetadata": true,
          "experimentalDecorators": true,
          "baseUrl": "./",
          "paths": {
               "@/*": [
                    "src/*"
               ],
          }
     },
     "include": [
          "src/**/*"
     ],
     "exclude": [
          "node_modules",
          "build"
     ],
}